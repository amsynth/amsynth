msgstr "გამოყენება: "

#: ../src/standalone/main.cpp:517
msgid " [options]"
msgstr " [პარამეტრები]"

#: ../src/standalone/main.cpp:519
msgid ""
"Any options given here override those in the config file ($HOME/.amSynthrc)"
msgstr ""
"აქ მითითებული პარამეტრი გადაფარავს კონფიგურაციის ფაილში ($HOME/.amSyncthrc) "
"მითითებულს"

#: ../src/standalone/main.cpp:521
msgid "OPTIONS:"
msgstr "პარამეტრები:"

#: ../src/standalone/main.cpp:523
msgid "\t-h          show this usage message"
msgstr "\t-h          ამ გამოყენების შეტყობინების ჩვენება"

#: ../src/standalone/main.cpp:524
msgid "\t-v          show version information"
msgstr "\t-v          ვერსიის ინფორმაციის ჩვენება"

#: ../src/standalone/main.cpp:525
msgid "\t-x          run in headless mode (without GUI)"
msgstr "\t-x          გაშვება უთავო რეჟიმში (ინტერფეისის გარეშე)"

#: ../src/standalone/main.cpp:527
msgid "\t-b <file>   use <file> as the bank to store presets"
msgstr "\t-b <file>   მითითებული ფაილის გამოყენება პრესეტების შესანახად"

#: ../src/standalone/main.cpp:528
msgid "\t-P <int>    set preset number to use"
msgstr "\t-P <int>    გამოსაყენებელი პრესეტის დაყენება"

#: ../src/standalone/main.cpp:529
msgid "\t-t <file>   use <file> as a tuning file"
msgstr "\t-t <file>   მითითებული ფაილის გამოყენება მორგების ფაილად"

#: ../src/standalone/main.cpp:531
msgid ""
"\t-a <string> set the sound output driver to use [alsa/oss/auto(default)]"
msgstr ""
"\t-a <string> გამოსაყენებელი ხმის გამოტანის დრაივერის დაყენება [alsa/oss/"
"auto(default)]"

#: ../src/standalone/main.cpp:532
msgid "\t-r <int>    set the sampling rate to use"
msgstr "\t-r <int>    გამოსაყენებელი სემპლინგის სიხშირის დაყენება"

#: ../src/standalone/main.cpp:533
msgid "\t-m <string> set the MIDI driver to use [alsa/oss/auto(default)]"
msgstr ""
"\t-m <string> გამოსაყენებელი MIDI დრაივერის დაყენება [alsa/oss/"
"auto(default)]"

#: ../src/standalone/main.cpp:534
msgid "\t-c <int>    set the MIDI channel to respond to (default=all)"
msgstr ""
"\t-c <int>    MIDI არხის დაყენება, რომელსაც უნდა ვუპასუხოთ "
"(ნაგულისხმევი=ყველა)"

#: ../src/standalone/main.cpp:535
msgid "\t-p <int>    set the polyphony (maximum active voices)"
msgstr "\t-p <int>    პოლიფონიის დაყენება (აქტიური ხმების მაქს. რაოდენობა)"

#: ../src/standalone/main.cpp:537
msgid "\t-n <name>   specify the JACK client name to use"
msgstr "\t-n <name>   მიუთითეთ JACK-ის კლიენტის სახელი გამოსაყენებლად"

#: ../src/standalone/main.cpp:538
msgid "\t--jack_autoconnect[=<true|false>]"
msgstr "\t--jack_autoconnect[=<true|false>]"

#: ../src/standalone/main.cpp:539
msgid ""
"\t            automatically connect jack audio ports to hardware I/O ports. "
"(Default: true)"
msgstr ""
"\t            jack-ის აუდიოპორტების აპარატურულ პორტებთან ავტომატური "
"დაკავშირება (ნაგულისხმევი: კი)"

#: ../src/standalone/main.cpp:541
msgid "\t--ui-scale <scale>"
msgstr "\t--ui-scale <მასშტაბი>"

#: ../src/standalone/main.cpp:542
msgid "\t            set the scaling factor for the GUI"
msgstr "\t            ინტერფეისის მასშტაბის კოეფიციენტის დაყენება"

#: ../src/standalone/main.cpp:651
#, c-format
msgid "amsynth running in headless mode, press ctrl-c to exit\n"
msgstr ""
"amsynth გაშვებულია უთავო რეჟიმში. გასასვლელად დააჭირეთ ღილაკებს ctrl-c\n"

#: ../src/standalone/main.cpp:656
#, c-format
msgid "shutting down...\n"
msgstr "გამორთვა…\n"

#: ../src/standalone/main.cpp:663
msgid " audio buffer underruns occurred\n"
msgstr " აღმოჩენილია აუდიოს ბუფერის არშევსებები\n"

